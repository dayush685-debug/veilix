# Veilix configuration template.
#
# Copy to .env and fill in. `.env` is gitignored and must never be committed.
# Generate secrets with:  openssl rand -hex 32
#
# Every variable marked REQUIRED is validated at API startup. Invalid or missing
# required configuration aborts the process rather than starting in a degraded
# state (fail fast, not fail quiet).

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------

# One of: development | testing | production
# In production the API refuses to start with placeholder secrets or debug enabled.
VEILIX_ENV=development

# Public hostname. For local development use `localhost` — Caddy then serves plain
# HTTP. Any other value makes Caddy request a real Let's Encrypt certificate, which
# requires public DNS pointing here and reachable ports 80 and 443.
VEILIX_DOMAIN=localhost

# Host ports. Defaults avoid 6379 and 8081, which are commonly already bound.
VEILIX_HTTP_PORT=8088
VEILIX_HTTPS_PORT=8443

# Caddy's listen address inside the container.
#   :8080                  any host, plain HTTP — correct for local development
#   search.example.com     triggers automatic Let's Encrypt certificate issuance,
#                          which requires public DNS pointing here and reachable
#                          ports 80 and 443
VEILIX_SITE_ADDRESS=:8080
VEILIX_ACME_EMAIL=

# ---------------------------------------------------------------------------
# Secrets  (REQUIRED — no defaults, startup fails if unset in production)
# ---------------------------------------------------------------------------

# SearXNG instance secret. Upstream ships the placeholder "ultrasecretkey";
# leaving that value in place is a real vulnerability, not a formality.
SEARXNG_SECRET=

# Salt seed for the rate limiter's IP hashing (see docs/adr/0003).
# The effective daily salt is derived from this plus the current date.
VEILIX_RATELIMIT_SALT_SEED=

# Admin dashboard credentials. The password is stored as an Argon2 hash, never
# in plaintext. Generate with:  python scripts/hash_secret.py
VEILIX_ADMIN_USERNAME=admin
VEILIX_ADMIN_PASSWORD_HASH=

# Comma-separated Argon2 hashes of issued API keys. Empty disables key auth,
# which is permitted only outside production.
VEILIX_API_KEY_HASHES=

# ---------------------------------------------------------------------------
# Internal service addresses  (container DNS names — not reachable from the host)
# ---------------------------------------------------------------------------

VEILIX_SEARXNG_URL=http://searxng:8080
VEILIX_VALKEY_URL=valkey://valkey:6379/0

# ---------------------------------------------------------------------------
# Search behaviour
# ---------------------------------------------------------------------------

# Safe search: 0 = off, 1 = moderate, 2 = strict
VEILIX_DEFAULT_SAFESEARCH=1
VEILIX_DEFAULT_LANGUAGE=auto
VEILIX_MAX_PAGE=10

# Timeout for the whole SearXNG call, in seconds. SearXNG's own per-engine
# timeout is 3.0s, so this must exceed it to allow slow engines to land.
VEILIX_SEARCH_TIMEOUT_S=8.0

# ---------------------------------------------------------------------------
# Cache  (see docs/privacy.md §7 for the timing side channel this creates)
# ---------------------------------------------------------------------------

VEILIX_CACHE_ENABLED=true
VEILIX_CACHE_TTL_S=300

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

VEILIX_RATELIMIT_ENABLED=true
VEILIX_RATELIMIT_REQUESTS=60
VEILIX_RATELIMIT_WINDOW_S=60

# Higher budget for authenticated API-key holders.
VEILIX_RATELIMIT_APIKEY_REQUESTS=600

# ---------------------------------------------------------------------------
# Resilience  (see docs/adr/0006 — one breaker, around SearXNG as a whole)
# ---------------------------------------------------------------------------

VEILIX_BREAKER_FAIL_THRESHOLD=5
VEILIX_BREAKER_RESET_TIMEOUT_S=30
VEILIX_SEARCH_MAX_RETRIES=1

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# debug | info | warning | error.  Query text is never logged at any level.
VEILIX_LOG_LEVEL=info
VEILIX_METRICS_ENABLED=true

# OpenTelemetry is instrumented but exports only when an endpoint is set.
# Leave blank to keep tracing off and run no collector container.
VEILIX_OTLP_ENDPOINT=

# Grafana admin password — only used with `--profile observability`.
GRAFANA_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma-separated origins. The SPA is same-origin behind Caddy and needs no
# entry here; this exists for third-party API consumers. Never set to "*"
# on an endpoint that accepts credentials.
VEILIX_CORS_ORIGINS=

# Veilix edge configuration.
#
# Caddy is the only container that publishes a port. It terminates TLS, applies
# security headers, serves the built SPA, and proxies the two paths that need a
# backend. Everything else in the stack is unreachable from outside.

{
	# No `email` directive: Let's Encrypt accepts accounts without one, and
	# an empty `email {$VAR:}` expansion is a parse error that stops Caddy
	# dead. Add `email you@example.com` if you want expiry notices.

	# The admin API can rewrite this config at runtime. Nothing needs it.
	admin off

	servers {
		protocols h1 h2 h3
	}
}

# ---------------------------------------------------------------------------
# Snippets
# ---------------------------------------------------------------------------

(security_headers) {
	header {
		# HSTS. Only meaningful over real TLS; harmless on localhost.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# img-src forbids third-party hosts outright, which only works because
		# every thumbnail is proxied through this origin. If proxying broke, the
		# page would visibly break instead of quietly leaking.
		#
		# The script hash covers the inline theme snippet in index.html.
		# scripts/check-csp-hash.sh fails CI when the two drift apart.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-hDIE5L8c2QNo5bnj6EbPg48FXSZGtpPRxpx+GhR1WPE='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests"

		# For agents predating frame-ancestors.
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"

		# Never tell a destination site that Veilix sent the visitor.
		Referrer-Policy "no-referrer"

		# Nothing here uses any of these.
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()"

		# Third-party content; keep this origin out of crawl indexes.
		X-Robots-Tag "noindex, nofollow"

		-Server
	}
}

(compression) {
	encode zstd gzip
}

# ---------------------------------------------------------------------------
# Site
#
# VEILIX_SITE_ADDRESS. A bare port serves plain HTTP; any real hostname
# triggers Let's Encrypt issuance, needing public DNS and ports 80/443.
# ---------------------------------------------------------------------------

{$VEILIX_SITE_ADDRESS::8080} {
	import security_headers
	import compression

	log {
		output stdout
		format json
		# The default access log would be a permanent record of every query
		# and every client address. Keep method, status, duration.
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				request>remote_ip delete
				# Caddy 1 called this remote_ip; deleting only that name leaves
				# an address on every line.
				request>client_ip delete
				request>host delete
				request>remote_port delete
				resp_headers delete
			}
		}
	}

	# --- API ---------------------------------------------------------------
	handle /api/* {
		reverse_proxy api:8000 {
			# Caddy logs a warning that these are "unnecessary". They are not.
			#
			# Its default is to APPEND the client address to whatever arrived, and
			# the API reads the FIRST entry. Under the default an attacker sets
			# X-Forwarded-For themselves, rotates it per request, and is never
			# limited, while the limiter reports healthy numbers. header_up
			# replaces the header. Do not delete this to silence the warning.
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}

	# Generated API documentation, served from the same origin.
	handle /openapi.json {
		reverse_proxy api:8000
	}
	handle /redoc* {
		reverse_proxy api:8000
	}

	# --- Image proxy -------------------------------------------------------
	#
	# The only path where Caddy reaches SearXNG. The API cannot serve these
	# bytes because it has no internet route (ADR-0004), so the fetch happens
	# in the container that does.
	#
	# Exposing only /image_proxy is what keeps `limiter: false` safe: SearXNG's
	# search, config and stats endpoints stay unreachable.
	handle /img* {
		# The API HMAC-signs these; SearXNG 400s anything unsigned.
		rewrite * /image_proxy?{query}
		reverse_proxy searxng:8080

		header {
			# The signature covers the source URL, so a changed image is a
			# changed URL.
			Cache-Control "public, max-age=86400, immutable"
			X-Content-Type-Options "nosniff"
		}
	}

	# --- Static SPA --------------------------------------------------------
	handle {
		root * /srv

		# Asset names are content-hashed so they cache forever. index.html must
		# not, or a deploy pins clients to a bundle whose assets are gone.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"

		# Client-side routing: a deep link must return the shell, not a 404.
		try_files {path} /index.html
		file_server
	}
}
